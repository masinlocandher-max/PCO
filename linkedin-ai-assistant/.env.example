# FMB AI Chief of Staff — configuration by example.
#
# Copy to .env and fill in locally. NEVER commit .env. Every value below is
# read from the environment at runtime and is never written to the database,
# a log line, or an error message.

# ── Who is accountable ───────────────────────────────────────────────────────
# Recorded on every approval. An approval with no identifiable decider is
# refused, so this is not optional in practice.
FMB_OPERATOR=Francine Marie Bautista

# ── Where the local store lives ──────────────────────────────────────────────
# Defaults to linkedin-ai-assistant/database/fmb_assistant.db, which is
# git-ignored. Point it outside the repository if you prefer.
# FMB_ASSISTANT_DB=/Users/fmb/Documents/fmb_assistant.db

# ── The two safety switches ──────────────────────────────────────────────────
# Both default to the safe position when unset. Leave them unset unless you have
# a reason not to.
#
# Master switch for anything that leaves this machine.
FMB_ALLOW_EXTERNAL=0
# Even with the above on, everything is a dry run until this is 1.
FMB_EXECUTE_FOR_REAL=0

# ── Local dashboard ──────────────────────────────────────────────────────────
# Binds 127.0.0.1 only. Never exposed to the network.
FMB_DASHBOARD_PORT=8765

# ── LinkedIn API (almost certainly not applicable) ───────────────────────────
# Posting as an individual needs LinkedIn's Community Management API and an
# approved developer application. Without that these do nothing, and the
# supported path is preparing text for FMB to post herself.
#
# If they are ever set: put them in .env or the shell, never in code, never in
# the database, never in a commit.
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_AUTHOR_URN=urn:li:person:XXXXXXXX
# LINKEDIN_API_VERSION=202411
